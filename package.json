{
    "name": "@oat-sa-private/read-aloud-client",
    "version": "0.7.3",
    "displayName": "Read aloud client",
    "description": "Vendor agnostic text to speech client",
    "module": "index.js",
    "main": "index.js",
    "browser": "dist/index.js",
    "scripts": {
        "lint": "eslint -c .eslintrc.js --ext js .",
        "lint:report": "eslint -c .eslintrc.js --output-file eslint_report.json --format json --ext js .",
        "build": "rollup -c rollup.config.js",
        "build:watch": "npm run build -- --watch",
        "build:dev": "rollup --watch -c sandbox/rollup.config.js",
        "test": "jest --config=jest.config.js",
        "test:watch": "npm test -- --watch",
        "test:cov": "npm test -- --coverage",
        "serve:sandbox": "sirv sandbox --port 5400 --dev --http2 --key keys/localhost-key.pem --cert keys/localhost-cert.pem",
        "dev:sandbox": "run-p serve:sandbox build:dev",
        "prepare": "npm run build"
    },
    "files": [
        "lib",
        "dist",
        "!**/test"
    ],
    "publishConfig": {
        "access": "restricted"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oat-sa/read-aloud-client-fe.git"
    },
    "author": {
        "name": "Open Assessment Technologies SA"
    },
    "license": "GPL-2.0",
    "bugs": {
        "url": "https://github.com/oat-sa/read-aloud-client-fe/issues"
    },
    "homepage": "https://github.com/oat-sa/read-aloud-client-fe#readme",
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.22.9",
        "@babel/preset-env": "^7.22.9",
        "@oat-sa/browserslist-config-tao": "^1.0.1",
        "@oat-sa/eslint-config-tao": "^2.0.0",
        "@oat-sa/prettier-config": "^0.1.1",
        "@rollup/plugin-babel": "^6.0.3",
        "@rollup/plugin-commonjs": "^25.0.3",
        "@rollup/plugin-node-resolve": "^15.1.0",
        "@rollup/plugin-terser": "^0.4.3",
        "@testing-library/dom": "^9.3.1",
        "@testing-library/user-event": "^14.4.3",
        "eslint": "^8.45.0",
        "jest": "^29.6.2",
        "jest-environment-jsdom": "^29.6.2",
        "npm-run-all": "^4.1.5",
        "prettier": "^2.8.8",
        "rollup": "^2.79.1",
        "sirv": "^2.0.3",
        "sirv-cli": "^2.0.2"
    },
    "browserslist": [
        "extends @oat-sa/browserslist-config-tao"
    ],
    "prettier": "@oat-sa/prettier-config",
    "dependencies": {
        "scroll-into-view-if-needed": "^3.0.10"
    }
}
